{
  "name": "thundercode",
  "version": "0.0.0",
  "private": true,
  "description": "Thunderbird MailExtension for inserting syntax-highlighted code blocks into HTML mail",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "bash scripts/package.sh",
    "changelog": "git-cliff --unreleased --strip all"
  },
  "devDependencies": {
    "git-cliff": "^2.13.1",
    "highlight.js": "11.12.0",
    "vitest": "^5.0.0"
  }
}
