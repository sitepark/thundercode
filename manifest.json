{
  "manifest_version": 3,
  "name": "ThunderCode",
  "version": "0.1.0",
  "description": "Insert syntax-highlighted code blocks into Thunderbird messages.",
  "browser_specific_settings": {
    "gecko": {
      "id": "thundercode@sitepark.com",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["compose", "scripting"],
  "compose_action": {
    "default_title": "Insert code block",
    "default_area": "formattoolbar",
    "default_popup": "src/popup/popup.html",
    "default_icon": "icons/thundercode.svg"
  }
}
